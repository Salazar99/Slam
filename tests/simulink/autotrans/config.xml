<slam>
	<!-- One context per golden-reference requirement (experiments/thesis/ground_truth.csv), configured by
	     `s2_sweep.py tune` (grid and choice in experiments/thesis/results/s2_tuning.csv). -->
	<context name="shift_gear1">
		<numeric op="le,ge" clsEffort="0.1" exp="speed" loc="dt"/>
		<template dtLimits="1A,0.1E,0maxd,0mind" exp="G( ..F.. -> F[0,0](gear == 1))" />
		<sort name="causality" exp="1-afct/traceLength"/>
		<sort name="support" exp="atct/traceLength"/>
	</context>
	<context name="shift_gear2up">
		<numeric op="le,ge" clsEffort="0.001" exp="speed" loc="dt"/>
		<template dtLimits="1A,0.1E,100maxd,0mind" exp="G( ..F.. -> F[0,0](gear >= 2))" />
		<sort name="causality" exp="1-afct/traceLength"/>
		<sort name="support" exp="atct/traceLength"/>
	</context>
	<context name="shift_gear3up">
		<numeric op="le,ge" clsEffort="0.1" exp="speed" loc="dt"/>
		<template dtLimits="1A,0.1E,20maxd,0mind" exp="G( ..F.. -> F[0,0](gear >= 3))" />
		<sort name="causality" exp="1-afct/traceLength"/>
		<sort name="support" exp="atct/traceLength"/>
	</context>
	<context name="shift_gear4">
		<numeric op="le,ge" clsEffort="0.001" exp="speed" loc="dt"/>
		<template dtLimits="1A,0.1E,0maxd,0mind" exp="G( ..F.. -> F[0,0](gear == 4))" />
		<sort name="causality" exp="1-afct/traceLength"/>
		<sort name="support" exp="atct/traceLength"/>
	</context>
</slam>
