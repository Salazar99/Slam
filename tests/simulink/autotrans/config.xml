	<context name="speed_below_35">
		<numeric op="le" clsEffort="0.01" exp="rpm" loc="dt"/>
		<template dtLimits="3A,0.1E,100maxd,0mind" exp="G( ..F.. -> F[0,0](speed < 35))" />
