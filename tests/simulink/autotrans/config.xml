<slam>
	<!-- sldemo_autotrans, 0.1 s per sample (maxd 100 = 10 s); one context per requirement consequent
	     (ARCH-COMP AT1, AT2, AT5x, AT6x). -->
	<context name="speed_limit">
		<numeric op="le,ge" clsEffort="0.01" exp="rpm" loc="dt"/>
		<numeric op="le,ge" clsEffort="0.01" exp="throttle" loc="dt"/>
		<template dtLimits="3A,0.1E,100maxd,0mind" exp="G( ..F.. -> F[0,0](speed < 120))" />
		<sort name="causality" exp="1-afct/traceLength"/>
		<sort name="support" exp="atct/traceLength"/>
	</context>
	<context name="rpm_limit">
		<numeric op="le,ge" clsEffort="0.01" exp="speed" loc="dt"/>
		<numeric op="le,ge" clsEffort="0.01" exp="throttle" loc="dt"/>
		<template dtLimits="3A,0.1E,100maxd,0mind" exp="G( ..F.. -> F[0,0](rpm < 4750))" />
		<sort name="causality" exp="1-afct/traceLength"/>
		<sort name="support" exp="atct/traceLength"/>
	</context>
	<context name="gear1">
